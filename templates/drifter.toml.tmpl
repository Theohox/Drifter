# Drifter configuration for {{PROJECT_NAME}}.
# See https://github.com/hox/drifter for documentation.

[tool.drifter]
root = "."
max_pending_age_days = 7
drift_threshold = 70

# Built-in checks (23 total)
[[tool.drifter.checks]]
name = "stale_reference"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "hardcoded_path"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "digest_staleness"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "conductor_health"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "cross_doc_consistency"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "git_safety"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "dangerous_patterns"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "timestamp_staleness"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "conductor_content"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "architecture_doc_sync"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "readme_completeness"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "pre_flight_sync"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "credential_leak"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "dead_code"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "test_coverage"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "cli_output"
enabled = true
severity = "warn"

[[tool.drifter.checks]]
name = "gitignore"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "pipeline_integrity"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "archive_integrity"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "tomllib_compatibility"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "audit_coverage"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "reporter_completeness"
enabled = true
severity = "error"

[[tool.drifter.checks]]
name = "template_count_sync"
enabled = true
severity = "warn"

# Paths to ignore during scanning
[tool.drifter.ignore]
paths = [
    "venv/",
    ".venv/",
    "node_modules/",
    "__pycache__/",
    ".git/",
    ".tox/",
    ".pytest_cache/",
    "target/",
    "dist/",
    "build/",
    "templates/",
]
